{
    "name": "whilesmart/reviews",
    "description": "Polymorphic reviews package for Laravel",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "WhileSmart",
            "email": "dev@whilesmart.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/support": "^12.0",
        "illuminate/database": "^12.0"
    },
    "autoload": {
        "psr-4": {
            "Whilesmart\\Reviews\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Whilesmart\\Reviews\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Whilesmart\\Reviews\\ReviewsServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require-dev": {
        "orchestra/testbench": "^10.8",
        "fakerphp/faker": "^1.24",
        "phpunit/phpunit": "^11.0"

    }
}
